# ---------------------------------------------------------------------------
# OpenSky Network (live flight positions)
# Free account: https://opensky-network.org/index.php?option=com_users&view=registration
# Create an API client (client_id/client_secret) at https://opensky-network.org/my-opensky
# Leave both blank to fall back to anonymous access (lower rate limits).
# ---------------------------------------------------------------------------
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Bounding box for polling (default: Israel)
OPENSKY_LAMIN=29.45
OPENSKY_LAMAX=33.35
OPENSKY_LOMIN=34.25
OPENSKY_LOMAX=35.90

# Seconds between polls of /states/all
POLL_INTERVAL_SECONDS=12

# ---------------------------------------------------------------------------
# RabbitMQ
# Defaults below are fine for local dev (ports aren't published to the host
# by docker-compose.yml). Change RABBITMQ_PASSWORD to a random value before
# deploying anywhere your Docker host's ports might become reachable.
# ---------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ---------------------------------------------------------------------------
# PostgreSQL
# Same note as RabbitMQ above: change POSTGRES_PASSWORD before deploying.
# ---------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=flighthub
POSTGRES_USER=flighthub
POSTGRES_PASSWORD=flighthub

# ---------------------------------------------------------------------------
# Open-Meteo (weather enrichment) — no API key required
# ---------------------------------------------------------------------------
# Grid size (degrees) used to bucket nearby flights onto a shared cached
# weather lookup, and how long a cached reading stays valid.
WEATHER_GRID_SIZE_DEG=1.0
WEATHER_CACHE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# AI layer — pick one provider, both have free tiers
# ---------------------------------------------------------------------------
# gemini or groq
LLM_PROVIDER=gemini

# Gemini: free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Groq: free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
DASHBOARD_REFRESH_SECONDS=15

# If set, the dashboard shows a password gate before rendering anything.
# Leave blank for local development. MUST be set before exposing the
# dashboard on the open internet, or anyone with the URL can burn your
# free-tier LLM quota via the AI panels.
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
